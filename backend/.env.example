# CodeQuiz AI Backend Environment Configuration
# Copy this file to .env and insert your API credentials.
# Do NOT commit .env with real credentials to version control.

# Server settings
HOST=0.0.0.0
PORT=8000

# AI Service Configuration
# Set your API key here (e.g. Gemini, OpenAI, or compatible AI provider)
AI_API_KEY=YOUR_API_KEY_HERE

# Model name (e.g. gemini-1.5-flash, gemini-1.5-pro, etc.)
AI_MODEL_NAME=gemini-1.5-flash

# Generation settings
REQUEST_TIMEOUT_SECONDS=45
MAX_RETRIES=2

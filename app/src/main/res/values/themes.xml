<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Modern Minimal Application Theme -->
    <style name="Base.Theme.CodeQuiz" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Component Styles -->
        <item name="materialButtonStyle">@style/Widget.CodeQuiz.Button</item>
        <item name="materialCardViewStyle">@style/Widget.CodeQuiz.Card</item>
        <item name="textInputStyle">@style/Widget.CodeQuiz.TextInputLayout</item>

        <!-- Dialog Theming -->
        <item name="alertDialogTheme">@style/ThemeOverlay.CodeQuiz.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.CodeQuiz.Dialog</item>

        <!-- Smooth Window Animations -->
        <item name="android:windowAnimationStyle">@style/Animation.CodeQuiz.Activity</item>
    </style>

    <style name="Theme.CodeQuiz" parent="Base.Theme.CodeQuiz" />

    <!-- Modern Minimal Button Style -->
    <style name="Widget.CodeQuiz.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textStyle">bold</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Modern Minimal Card Style -->
    <style name="Widget.CodeQuiz.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Modern Clean Text Input Layout -->
    <style name="Widget.CodeQuiz.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="hintTextColor">@color/primary</item>
    </style>

    <!-- CodeQuiz Custom Dialog Theme -->
    <style name="ThemeOverlay.CodeQuiz.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearance">@style/ShapeAppearance.CodeQuiz.Dialog</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.CodeQuiz.Dialog</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.CodeQuiz.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.CodeQuiz.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.CodeQuiz.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.CodeQuiz.DialogButton.Negative</item>
    </style>

    <style name="ShapeAppearance.CodeQuiz.Dialog" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="TextAppearance.CodeQuiz.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CodeQuiz.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="Widget.CodeQuiz.DialogButton.Positive" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/on_primary</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.CodeQuiz.DialogButton.Negative" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="backgroundTint">@color/surface_variant</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Smooth Lightweight Activity Window Transitions -->
    <style name="Animation.CodeQuiz.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>
